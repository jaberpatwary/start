[Unit]
Description=MI-Tech Full-Stack Application (Docker Compose)
Requires=docker.service
After=docker.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/startech-clone
ExecStart=/usr/bin/docker compose --env-file .env.production up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.production down
ExecReload=/usr/bin/docker compose --env-file .env.production restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
