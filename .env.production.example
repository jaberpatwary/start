# ==============================================================================
# MI-Tech (StarTech Clone) — Production Environment Configuration
# Instructions: Copy this file to .env.production on your production server:
#   cp .env.production.example .env.production
# Fill in real values before running: docker compose --env-file .env.production up -d
# ==============================================================================

# --- Application Environment ---
APP_ENV=production
PORT=8090
HTTP_PORT=80
HTTPS_PORT=443

# --- Public Domain & URLs ---
# Replace with your actual domain (e.g., mi-tech.bd.xy or https://yourdomain.com)
DOMAIN_NAME=yourdomain.com
CLIENT_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- PostgreSQL Production Database ---
# Choose a strong password for your database in production!
POSTGRES_DB=startech_prod
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=replace_with_a_super_strong_password_32_chars_long

# Internal database connection URL used by the Go backend container:
DATABASE_URL=postgres://postgres_user:replace_with_a_super_strong_password_32_chars_long@postgres:5432/startech_prod?sslmode=disable

# Database connection pooling parameters
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=15
DB_CONN_MAX_LIFETIME_MIN=5
DB_CONN_MAX_IDLE_MIN=15

# --- Security & JWT Secret ---
# IMPORTANT: Generate a 64+ char random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_this_with_a_long_cryptographically_secure_random_string_in_production

# --- File Storage Directory ---
UPLOAD_DIR=/app/uploads

# --- Frontend API URL ---
# Leave blank to use relative '/api/v1' through Nginx reverse proxy (RECOMMENDED)
# Or set explicitly if using a dedicated API subdomain (e.g., https://api.yourdomain.com/api/v1)
VITE_API_URL=
