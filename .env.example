# ===================================================
# StarTech Clone - Unified Environment Config Example
# Copy to .env for local development:
#   cp .env.example .env
# ===================================================

# --- Server / Backend Configuration ---
PORT=8090
APP_ENV=development
DATABASE_URL=postgres://postgres:root@localhost:5432/start?sslmode=disable
JWT_SECRET=startech_secret_key_2026
CLIENT_URL=http://localhost:8888
UPLOAD_DIR=./uploads

# Database connection pool settings (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5
DB_CONN_MAX_IDLE_MIN=15

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8888,http://localhost:5173,http://localhost:8090

# --- Client / Frontend Configuration ---
VITE_API_URL=http://localhost:8090/api/v1
